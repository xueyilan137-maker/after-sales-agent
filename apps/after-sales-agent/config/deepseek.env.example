# Put the real key only in vendor/deer-flow/.env (ignored by Git).
# An empty key allows infrastructure setup, but cannot perform model inference.
DEEPSEEK_API_KEY=
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai
# Local build workaround: the first official Debian CDN attempt returned 502.
# Supported upstream build argument; Debian signature checks remain enabled.
# Remove this line to use the upstream default CDN.
APT_MIRROR=mirrors.ustc.edu.cn
