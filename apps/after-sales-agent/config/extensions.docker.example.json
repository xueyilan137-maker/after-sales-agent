{
  "middlewares": ["after_sales.plugin:AfterSalesMiddleware"],
  "mcpInterceptors": ["after_sales.identity:build_identity_interceptor"],
  "mcpServers": {
    "after-sales-demo": {
      "enabled": true,
      "type": "stdio",
      "command": "/app/backend/.venv/bin/python",
      "args": ["/app/business-mcp/after_sales_mcp/__main__.py"],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONPATH": "/app/backend",
        "AFTER_SALES_DATA_DIR": "/app/after-sales-data"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 30,
      "tool_call_timeout": 15,
      "description": "Synthetic after-sales orders, policy retrieval, tickets and approved demo execution. Human approval is available only in the authenticated workbench."
    }
  },
  "skills": {}
}
